# Supabase (Project Settings > API). Use apenas a chave anon/publishable no frontend.
VITE_SUPABASE_URL="https://SEU-PROJETO.supabase.co"
VITE_SUPABASE_ANON_KEY="SUA_CHAVE_ANON_OU_PUBLISHABLE"
VITE_APP_URL="https://mercadodocompositor.com.br"
VITE_GOOGLE_AUTH_ENABLED="true"

# Endpoint HTTP opcional para eventos de erro e Web Vitals sanitizados.
VITE_OBSERVABILITY_ENDPOINT=""
# Identificador da versão/deploy enviado junto à telemetria.
VITE_APP_RELEASE="local"

# Mercado Pago (Chave Publica para o Frontend - opcional)
VITE_MERCADOPAGO_PUBLIC_KEY=""

# As credenciais de servidor do Mercado Pago NAO entram aqui: variavel VITE_* vai
# para o bundle do navegador. MERCADOPAGO_ACCESS_TOKEN e
# MERCADOPAGO_WEBHOOK_SECRET sao secrets das Edge Functions
# (ver supabase/functions/.env.example).
