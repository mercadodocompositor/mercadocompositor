Options -MultiViews
RewriteEngine On

# HTTPS obrigatório (o X-Forwarded-Proto cobre o proxy/CDN da Hostinger).
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Domínio canônico sem www (igual ao <link rel="canonical"> e ao sitemap).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Perfis públicos passam pelo compositor.php, que injeta título e Open Graph do
# compositor (prévia no WhatsApp/redes) e devolve a mesma SPA. QSA mantém o ?musica=.
RewriteRule ^compositor/([A-Za-z0-9-]{1,60})/?$ compositor.php?u=$1 [L,QSA]

# og-config.php só existe para o compositor.php; não responde a acesso direto.
RewriteRule ^og-config\.php$ - [F,L]

# Entrega arquivos reais normalmente e encaminha rotas do React para o app.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

  # CSP em modo Report-Only: só registra violações no console do navegador,
  # não bloqueia nada. Depois de navegar pelo site (home, cadastro, upload de
  # prévia, player, PDF, checkout) sem violações, troque
  # "Content-Security-Policy-Report-Only" por "Content-Security-Policy".
  # Se usar VITE_OBSERVABILITY_ENDPOINT, inclua o domínio dele em connect-src.
  # O sha256 em script-src é do script de tema inline do index.html: se esse
  # script mudar (ou ganhar quebras de linha CRLF), o hash precisa ser refeito.
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'sha256-J2YIf71y/IivTAgNnwYhxs78RzTva5kBS6j+pLfHI80=' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://*.supabase.co https://images.unsplash.com https://lh3.googleusercontent.com; media-src 'self' blob: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"

  # index.html nunca em cache: senão o navegador guarda a versão antiga e
  # tenta carregar /assets/*.js que já não existem depois de um deploy.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # JS e CSS saem do build com hash no nome: podem ficar em cache por 1 ano.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/wasm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  # Imagens de public/ (logo etc.) não têm hash: cache menor.
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
